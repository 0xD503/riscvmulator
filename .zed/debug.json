[
  {
    "label": "riscvmulator (relase-checked profile)",
    "adapter": "CodeLLDB",
    "request": "launch",
    "build": {
      "command": "just",
      "args": ["build-dev"]
    },
    "program": "$ZED_WORKTREE_ROOT/target/release-checked/riscvmulator",
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "RVMULATOR_EMULATOR__LOGGING__LEVEL": "debug",
      "RUST_BACKTRACE": "full"
    },
    "sourceLanguages": ["rust"]
  },
  {
    "label": "riscvmulator (debug profile)",
    "adapter": "CodeLLDB",
    "request": "launch",
    "build": {
      "command": "just",
      "args": ["build-deb"]
    },
    "program": "$ZED_WORKTREE_ROOT/target/debug/riscvmulator",
    "cwd": "$ZED_WORKTREE_ROOT",
    "env": {
      "RVMULATOR_EMULATOR__LOGGING__LEVEL": "debug",
      "RUST_BACKTRACE": "full"
    },
    "sourceLanguages": ["rust"]
  }
]
