{
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "cargo": {
          "targetDir": true,
          "features": ["print-instructions"]
        },
        "check": {
          "extraArgs": ["--profile=release-checked"]
        }
      }
    }
  },
  "dap": {
    "CodeLLDB": {
      "binary": "/opt/codelldb/adapter/codelldb"
    }
  }
}
